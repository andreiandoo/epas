# Kit deploy .htaccess — clean URLs → front controller.
# Renamed to `.htaccess` at build time.

Options -Indexes
DirectoryIndex index.php

ErrorDocument 403 /403
ErrorDocument 500 /500
ErrorDocument 503 /503

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Dotfiles FIRST — must precede the -f passthrough below, whose [L] would
    # otherwise end the round and serve them. .deploy-token is the shared secret
    # that triggers a deploy; .git and .env would be worse.
    RewriteRule "(^|/)\.(?!well-known)" - [F,L]

    # Serve real files/dirs directly (theme/, kit/js, api/, favicon, images, css)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else → front controller
    RewriteRule ^ index.php [L]
</IfModule>

# Compression (text assets) ------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/calendar
</IfModule>

# Cache static assets long; HTML stays fresh --------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType application/manifest+json "access plus 7 days"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|png|webp|woff2?)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# Never serve source/config to the browser -------------------------------
# The site root doubles as its own source tree, and the rewrite above serves
# any real file directly — so everything that is not an entry point has to be
# denied explicitly. Entry points: index.php, api/proxy.php, _webhook-deploy.php.
<FilesMatch "^(site\.config|routes)\.php$">
    Require all denied
</FilesMatch>
RedirectMatch 403 ^/includes/
RedirectMatch 403 ^/pages/
RedirectMatch 403 ^/kit/(core|components|layouts|pagesets|kinds|tokens|deploy)/
RedirectMatch 403 ^/kit/proxy\.php$
