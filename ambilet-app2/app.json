{
  "expo": {
    "name": "AmBilet Scan NEXT",
    "slug": "ambilet-scan-next",
    "version": "2.2.0-dev.2",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permite accesul la cameră pentru scanarea codurilor QR ale biletelor."
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F2F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ambilet.scan.next",
      "infoPlist": {
        "NSCameraUsageDescription": "Permite accesul la cameră pentru scanarea codurilor QR ale biletelor."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F2F2"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.ambilet.scan.next",
      "permissions": ["VIBRATE", "INTERNET", "ACCESS_NETWORK_STATE", "CAMERA", "CALL_PHONE"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "// sentryDsn": "Fill with your Sentry project DSN. Leave empty to disable crash reporting. Example: https://xxx@oXXX.ingest.sentry.io/XXX",
      "sentryDsn": ""
    }
  }
}
