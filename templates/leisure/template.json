{
    "name": "Parc de agrement",
    "description": "Natural, luminos, cu rezervare pe zi și pe interval orar: bilete de acces, activități, închirieri, calendar cu locuri reale. Pentru parcuri, rezervații, aquaparcuri, saline, muzee.",
    "version": 1,
    "category": "Agrement & natură",
    "kind": "leisure",
    "status": "draft",
    "visibility": "public",
    "preview_image": "preview.jpg",
    "motion": [],
    "tailwind_preflight": true,

    "tailwind_extend": {
        "colors": {
            "pine": {
                "950": "rgb(var(--c-pine-950) / <alpha-value>)",
                "900": "rgb(var(--c-pine-900) / <alpha-value>)",
                "850": "rgb(var(--c-pine-850) / <alpha-value>)",
                "800": "rgb(var(--c-pine-800) / <alpha-value>)",
                "700": "rgb(var(--c-pine-700) / <alpha-value>)",
                "600": "rgb(var(--c-pine-600) / <alpha-value>)"
            },
            "acid": "rgb(var(--c-primary) / <alpha-value>)",
            "cream": "rgb(var(--c-canvas) / <alpha-value>)",
            "oat": "rgb(var(--c-surface) / <alpha-value>)",
            "ink": "rgb(var(--c-fg) / <alpha-value>)",
            "ember": "#f27b4a",
            "moss": "#b7c9a3",
            "sky": "#b8dce0"
        },
        "boxShadow": {
            "lift": "0 36px 100px -38px rgb(var(--c-pine-950) / .58)",
            "card": "0 18px 48px -28px rgb(var(--c-pine-950) / .46)",
            "acid": "0 18px 54px -24px rgb(var(--c-primary) / .58)"
        }
    },

    "settings": [
        { "name": "today_hours", "type": "text", "label": "Program (afișat în antet)", "default": "09:00–20:00", "help": "Ex.: 09:00–20:00. Gol = nu se afișează." },
        { "name": "last_entry", "type": "text", "label": "Ultima intrare", "default": "18:30" },
        { "name": "address", "type": "text", "label": "Adresa parcului", "default": "" }
    ],

    "theme": {
        "colors": {
            "canvas": "#FFFDF6",
            "surface": "#F0ECDF",
            "panel": "#FFFFFF",
            "fg": "#16231E",
            "muted": "#64736D",
            "primary": "#DFFC62",
            "accent": "#09251D"
        },
        "fonts": {
            "display": "Fraunces",
            "body": "DM Sans"
        }
    },

    "links": {
        "events": "/experiente",
        "catalog": "/experiente",
        "event": "/experienta/{slug}",
        "subscriptions": "/abonamente",
        "contact": "/contact"
