                        { "title": "Intri cu codul QR", "text": "Primești biletele pe email. Le arăți la intrare de pe telefon sau tipărite." }
                    ]
                } },
                { "type": "cta_next", "data": { "ghost": "Hajime", "button_label": "Cumpără bilete" } }
            ]
        },
