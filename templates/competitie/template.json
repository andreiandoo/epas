        },
        "text": {
            "label": "Text",
            "icon": "heroicon-o-bars-3",
            "fields": [
                { "name": "eyebrow", "type": "text", "label": "Supratitlu" },
                { "name": "title", "type": "text", "label": "Titlu" },
                { "name": "text", "type": "textarea", "label": "Text", "help": "Un rând gol între paragrafe" },
                { "name": "button_label", "type": "text", "label": "Buton — text (opțional)" },
                { "name": "button_url", "type": "text", "label": "Buton — link" }
            ]
