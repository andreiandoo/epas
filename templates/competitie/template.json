                { "name": "secondary_url", "type": "text", "label": "Buton secundar — link" },
                { "name": "show_3d", "type": "toggle", "label": "Scena 3D (pe calculator; pe telefon o versiune ușoară)" },
                { "name": "show_next", "type": "toggle", "label": "Cardul „Urmează” cu numărătoare inversă" }
