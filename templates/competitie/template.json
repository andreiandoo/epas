                { "name": "words", "type": "textarea", "label": "Cuvinte", "help": "Câte unul pe rând" }
            ]
        },
        "spotlight": {
            "label": "Competiția în prim-plan",
            "icon": "heroicon-o-star",
            "fields": [
                { "name": "event_slug", "type": "text", "label": "Slug competiție", "help": "Gol = următoarea competiție" },
                { "name": "button_label", "type": "text", "label": "Buton — text" }
            ]
        },
        "season": {
            "label": "Calendarul sezonului",
            "icon": "heroicon-o-calendar-days",
            "fields": [
                { "name": "eyebrow", "type": "text", "label": "Supratitlu" },
                { "name": "title", "type": "text", "label": "Titlu" },
                { "name": "link_label", "type": "text", "label": "Link spre calendar — text" },
                { "name": "one_title", "type": "text", "label": "Titlu când e o singură competiție" },
                { "name": "one_text", "type": "textarea", "label": "Text când e o singură competiție" },
                { "name": "empty_title", "type": "text", "label": "Titlu când nu e nicio competiție" },
                { "name": "empty_text", "type": "textarea", "label": "Text când nu e nicio competiție" },
                { "name": "external_label", "type": "text", "label": "Buton extern — text (opțional)" },
                { "name": "external_url", "type": "text", "label": "Buton extern — link" }
            ]
        },
        "steps": {
            "label": "Pași (cum funcționează)",
            "icon": "heroicon-o-list-bullet",
            "fields": [
                { "name": "eyebrow", "type": "text", "label": "Supratitlu" },
                { "name": "title", "type": "text", "label": "Titlu" },
                { "name": "anchor", "type": "text", "label": "Ancoră", "help": "Pentru link-uri de tipul #cum-functioneaza" },
                { "name": "items", "type": "repeater", "label": "Pași", "max": 4, "fields": [
                    { "name": "title", "type": "text", "label": "Titlu" },
                    { "name": "text", "type": "textarea", "label": "Text" }
                ] }
            ]
        },
        "cta_next": {
            "label": "Îndemn final (următoarea competiție)",
            "icon": "heroicon-o-megaphone",
            "fields": [
                { "name": "ghost", "type": "text", "label": "Cuvânt mare în fundal" },
                { "name": "button_label", "type": "text", "label": "Buton — text" }
            ]
        },
        "page_header": {
            "label": "Antet de pagină",
            "icon": "heroicon-o-bars-3-bottom-left",
            "fields": [
                { "name": "eyebrow", "type": "text", "label": "Supratitlu" },
                { "name": "title", "type": "text", "label": "Titlu" },
                { "name": "subtitle", "type": "textarea", "label": "Subtitlu" }
