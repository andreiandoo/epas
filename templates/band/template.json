    "theme": {
        "colors": {
            "canvas": "#070A12",
            "surface": "#0E1422",
            "panel": "#121A2B",
            "fg": "#E8ECF4",
            "muted": "#8A94A8",
            "primary": "#FF6B2C",
            "accent": "#3DE0C8"
        },
        "fonts": {
            "display": "Space Grotesk",
            "body": "Work Sans"
        }
    },

    "links": {
        "events": "/turneu",
        "catalog": "/turneu",
        "event": "/concert/{slug}"
    },

    "routes": {
        "/turneu": "turneu.php",
        "/concert/{slug}": "concert.php"
    },

    "nav": [
        { "label": "Turneu", "url": "/turneu" },
