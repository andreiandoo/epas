{
    "name": "Trupă",
    "description": "Site de trupă construit ca un univers propriu: globul cu orașele turneului, jurnalul de zbor cu bilete, echipajul, discografia ca misiuni, concert pe locuri numerotate cu hartă, lista fanilor. Pentru formații.",
    "version": 1,
    "category": "Muzică",
    "kind": "events",
    "status": "ready",
    "visibility": "public",
    "preview_image": "preview.jpg",
    "motion": ["lenis", "gsap"],
    "tailwind_preflight": true,

    "settings": [
        { "name": "featured_slug", "type": "text", "label": "Concertul din afiș (slug)", "default": "", "help": "Gol = următorul concert" }
